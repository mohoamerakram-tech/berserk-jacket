# Public configuration. Values prefixed with NEXT_PUBLIC_ are included in the browser bundle.
NEXT_PUBLIC_WHATSAPP_NUMBER=2126XXXXXXXX

# Single-admin authentication. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt\$RANDOM_SALT_HEX\$SCRYPT_HASH_HEX
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Production catalog and media storage. Keep the service-role key server-side.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Set only when the named header is overwritten by a trusted reverse proxy.
# ADMIN_CLIENT_IP_HEADER=x-real-ip
# REMBG_CLIENT_IP_HEADER=x-real-ip
